# Terraform: proveedores descargados, estado, planes y archivos locales
**/.terraform/
*.tfstate
*.tfstate.*
terraform.tfstate.d/
*.tfplan
*.tfplan.*
tfplan
plan.out
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Los .tfvars sin secretos y .terraform.lock.hcl se pueden versionar
*secret*.tfvars
*secret*.tfvars.json

# Credenciales y configuraciones locales
.env
.env.*
!.env.example
!.env.*.example
.aws/
.kube/
kubeconfig
*.kubeconfig
# Kubeconfig generado por el proveedor KinD
/terraform/*-config
/.aws-lab/
/aws-lab.local.json

# Dependencias y archivos generados por Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/reports/

# Archivos generados por Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Herramientas descargadas y archivos del editor/sistema
/kubectl
.idea/
.DS_Store
*.swp

# Documento del curso utilizado como referencia local
Proyecto_Integrador_Cloud_Computing.pdf
